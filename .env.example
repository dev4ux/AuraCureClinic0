# Copy to .env.local and fill in. Never commit .env.local.

# Production domain, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.auracureclinic.in

# GA4 measurement ID. Leave empty to disable analytics entirely —
# no third-party script loads without it.
NEXT_PUBLIC_GA4_ID=

# Server-side only. Destination that receives appointment requests
# (e.g. an email service, CRM or automation webhook).
# Until this is set, the appointment form tells patients to call or WhatsApp.
APPOINTMENT_WEBHOOK_URL=
